{
  "name": "@multi-indiegame/akashic-player-ban",
  "version": "0.1.0",
  "description": "ゲーム進行からプレイヤーを追放するための Akashic Engine 拡張ライブラリ（コンテンツ側）",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "default": "./lib/protocol.js"
    }
  },
  "files": [
    "lib",
    "protocol.js",
    "protocol.d.ts",
    "akashic-lib.json",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf ./lib",
    "build": "npm run clean && tsc -p ./",
    "prepublishOnly": "npm run build",
    "postbuild": "node ./scripts/emit-reference.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/multi-indiegame/akashic-player-ban.git",
    "directory": "packages/akashic-player-ban"
  },
  "keywords": [
    "akashic",
    "akashic-extension"
  ],
  "license": "MIT",
  "devDependencies": {
    "@akashic/akashic-engine": "~3.21.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
